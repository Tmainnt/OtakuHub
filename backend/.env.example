# Backend Environment Variables (backend/.env.example)
PORT=8081
# Local default; Render deployment sets BIND_ADDRESS=0.0.0.0 in render.yaml.
BIND_ADDRESS=127.0.0.1
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=otakuhub
# For a hosted provider, prefer DATABASE_URL. If using DB_* values, set DB_SSLMODE
# to the mode required by the provider (Render internal Postgres can use disable).
DB_SSLMODE=disable
DATABASE_URL=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=
