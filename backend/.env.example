# Backend Environment Variables (backend/.env.example)
PORT=8081
# Keep loopback binding when forwarding through a local ngrok agent.
# Set to 0.0.0.0 when running behind a hosting platform's public proxy.
BIND_ADDRESS=127.0.0.1
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=otakuhub
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=
