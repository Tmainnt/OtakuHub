# Local frontend development. In Vercel set NEXT_PUBLIC_API_URL=/api so the
# server-side proxy can keep the ngrok Basic Auth credentials out of the browser.
NEXT_PUBLIC_API_URL=http://localhost:8081/api
NEXT_PUBLIC_WS_URL=ws://localhost:8081/api/chat/ws

# Server-only Vercel variables. Set these in the Vercel dashboard, not in
# NEXT_PUBLIC_* variables. Upstream URL must include /api and use HTTPS.
OTAKUHUB_API_UPSTREAM_URL=https://your-ngrok-domain.ngrok.app/api
NGROK_BASIC_AUTH_USER=otakuhub
NGROK_BASIC_AUTH_PASSWORD=replace-with-a-long-random-secret
